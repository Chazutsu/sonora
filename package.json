{
  "name": "sonora",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Listen to, review, and respond to your Obsidian notes",
  "license": "MIT",
  "repository": "github:Chazutsu/sonora",
  "main": "main.js",
  "scripts": {
    "build": "BUILD=production rolldown -c && cp src/styles.css styles.css",
    "check:toolchain": "node scripts/check-toolchain-compat.mjs",
    "build:visual": "rolldown -c rolldown.visual.config.ts && cp node_modules/virtual-obsidian/wasm-pkg/core_bg.wasm tests/visual/dist/core_bg.wasm",
    "check:release": "pnpm build && node scripts/verify-release.mjs",
    "test": "vitest run",
    "test:visual": "pnpm build && pnpm build:visual && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "pnpm build && pnpm build:visual && playwright test -c playwright.visual.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/",
    "check:obsidian": "eslint src/",
    "format": "oxfmt --write src/ tests/",
    "format:check": "oxfmt --check src/ tests/"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "obsidian-plugin-kit": "https://github.com/Chazutsu/obsidian-plugin-kit/archive/refs/tags/v0.1.0.tar.gz",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "virtual-obsidian": "https://github.com/Chazutsu/virtual-obsidian/archive/refs/tags/v0.1.0.tar.gz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "^28.1.0",
    "obsidian": "1.14.4",
    "oxfmt": "0.34.0",
    "oxlint": "^1.48.0",
    "rolldown": "1.0.0-rc.5",
    "typescript": "6.0.0-beta",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
